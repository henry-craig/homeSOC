# SSH Brute Force Detection
# Timeline of failed/successful SSH logins on target.
# See hydra-command.txt for the attack command used.

index=main host="target-VMware-Virtual-Platform" ("Failed password" OR "Accepted password")
| rex field=_raw "from (?<src_ip>\d+\.\d+\.\d+\.\d+)"
| rex field=_raw "(?:Failed|Accepted) password for (?<user>\S+)"
| eval result=if(match(_raw, "Accepted"), "SUCCESS", "FAILURE")
| table _time, result, src_ip, user
| sort _time